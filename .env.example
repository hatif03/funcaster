# Worker only (`.env.worker`)
# The key that creates registries, mints seats, writes records, grants and revokes
ENS_REGISTRAR_KEY=
# Submits funding authorizations, create, settle, claim, refund; **pays all Arc gas** and bankrolls play money
ARC_RELAYER_KEY=
# Signs propose (layer B); a **different key** from the relayer
ARC_ORACLE_KEY=
# Creates, extends, deletes and transfers this console's Arkiv entities; sends the profile GLM drip
ARKIV_CONSOLE_KEY=
# ARKIV_SPONSOR_KEY is obsolete; use ARKIV_CONSOLE_KEY above.
# 1 stops all sending (also: the file ${WEB3_DATA_DIR}/KILL)
WEB3_KILL=
# Spend and abuse caps
WEB3_MAX_TX_PER_ROOM=
# Spend and abuse caps
WEB3_MAX_TX_PER_HOUR=
# Creates, cancels (before close) and funds bonuses
MARKET_OPERATOR_KEY=
# The relay's report signer (layer A)
MARKET_REPORTER_A_KEY=
# Signs the bet permits (seated-player exclusion, per-human caps)
MARKET_PERMIT_KEY=
# Layer B's signer, held by the **separate verifier process** (scripts/web3-verifier.mjs, its own env file and ideally its own machine)
MARKET_VERIFIER_KEY=
# Signs the daily stats checkpoint and the Ledger head
CHECKPOINT_SIGNER_KEY=
# A second relayer, so one censoring relayer cannot stop bets
ARC_RELAYER_KEY_2=

